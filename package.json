{
  "name": "dsh-grafana-plugin",
  "version": "0.3.0",
  "description": "Grafana 集成插件：替代重型 Grafana MCP server，提供 dashboard/folder 查询、Prometheus/Loki 查询、Alerting 只读工具（按类别裁剪工具面），并在插件页提供设置面板。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "build-faces.ts",
    "scripts/prepare.ts",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.0.1"
  },
  "dshx": {
    "contributes": {
      "tools": [
        "grafana_search_dashboards",
        "grafana_get_dashboard",
        "grafana_list_datasources",
        "grafana_query_prometheus",
        "grafana_list_prometheus_metrics",
        "grafana_list_prometheus_labels",
        "grafana_query_loki",
        "grafana_list_loki_labels",
        "grafana_list_alert_rules",
        "grafana_get_alert_rule"
      ]
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "//peers": "The harness packages this plugin runs against are deliberately NOT declared here. pnpm resolves a peer's own peer graph when installing, and that walk reaches harness-internal packages that were never published (@deepseek-ai/dsh-type-meta), so ANY @deepseek-ai peer entry - required or optional - makes `dsh plugin add github:...` fail with ERR_PNPM_FETCH_404 before prepare can run. dsh supplies these modules from its own runtime, so nothing is lost; the local build/devDependencies still type-check against them.",
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsdown": "^0.19.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "prepare": "node --experimental-strip-types scripts/prepare.ts",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json"
  }
}
