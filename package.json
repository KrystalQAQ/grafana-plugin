{
  "name": "dsh-grafana-plugin",
  "version": "0.1.0",
  "description": "Grafana 集成插件：替代重型 Grafana MCP server，提供 dashboard/folder 查询、Prometheus/Loki 查询、Alerting 只读工具（按类别裁剪工具面）。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.0.1"
  },
  "dshx": {
    "contributes": {
      "tools": [
        "grafana_search_dashboards",
        "grafana_get_dashboard",
        "grafana_list_datasources",
        "grafana_query_prometheus",
        "grafana_list_prometheus_metrics",
        "grafana_list_prometheus_labels",
        "grafana_list_prometheus_label_values",
        "grafana_query_loki",
        "grafana_list_loki_labels",
        "grafana_list_loki_label_values",
        "grafana_list_alert_rules",
        "grafana_get_alert_rule"
      ]
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsdown": "^0.19.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "typecheck": "tsc -p tsconfig.json"
  }
}
